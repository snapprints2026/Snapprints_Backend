# Copy to .env for local development. On Railway, set these in Variables.

PORT=5000
API_BASE_URL=https://uploadsnapprints-production.up.railway.app/api

# Database (DB_* or Railway's MYSQL* variables)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo request emails (Resend)
RESEND_API_KEY=
TO_EMAIL=

# Customer OTP login before upload.
#   false = DEMO: scan QR → upload page directly, no OTP
#   true  = LAUNCH: customer must verify mobile OTP first (default if unset)
REQUIRE_CUSTOMER_LOGIN=false

# Cloudflare R2 — customer documents (private bucket)
# Cloudflare dashboard → R2 → Overview → Account Details → API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snapprints-uploads
# How long the signed upload/download links work (seconds)
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=600

# Uploaded files are deleted after this many minutes (unless the job is paid and waiting, or printing)
UPLOAD_MAX_AGE_MINUTES=30
